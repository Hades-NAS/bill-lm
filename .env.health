# Tracked, inert runtime fixture for health.sh. These values must never grant
# access to Firebase, databases, queues, object storage, or an LLM provider.
NODE_ENV=test
DATABASE_URL=postgresql://health:health@127.0.0.1:5432/bill_lm_health
GOOGLE_APPLICATION_CREDENTIALS=/tmp/bill-lm-health-firebase-admin.json
MINIO_ENDPOINT=127.0.0.1
MINIO_ACCESS_KEY=health-access-key
MINIO_SECRET_KEY=health-secret-key
MINIO_BUCKET_NAME=bill-lm-health
ANALYZE_QUEUE_NAME=bill-lm-health
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
FAKE_ANALYZE=true
BYOK_ENCRYPTION_KEY=health-only-not-a-production-secret
LLM_PROVIDER=lm-studio
LLM_BASE_URL=http://127.0.0.1:1234/v1
MODEL_KEY=health-model
VITE_APP_TITLE=Bill LM Health
VITE_FIREBASE_API_KEY=health-public-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=bill-lm-health.invalid
VITE_FIREBASE_PROJECT_ID=bill-lm-health
VITE_FIREBASE_STORAGE_BUCKET=bill-lm-health.invalid
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:healthfixture
