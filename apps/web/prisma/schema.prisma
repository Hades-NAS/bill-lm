generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(uuid())

  primaryEmail String? @db.VarChar(255)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz

  // Relaciones
  collections    Collection[]
  authIdentities AuthIdentity[]
  providerConnections ProviderConnection[]
  fiscalReferences FiscalReference[]
  economicActivities EconomicActivity[]
  economicActivityRevisions EconomicActivityRevision[]
  taxpayerProfiles TaxpayerProfile[]
  taxpayerProfileRevisions TaxpayerProfileRevision[]
  taxpayerProfileActivityRevisions TaxpayerProfileActivityRevision[]
  collectionContextRevisions CollectionContextRevision[]
  collectionContextActivityRevisions CollectionContextActivityRevision[]

  @@map("users")
}

/// Actividad económica reutilizable y definida por el usuario. No representa
/// un catálogo oficial ni permite inferir hechos tributarios.
model EconomicActivity {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  revisions EconomicActivityRevision[]

  @@unique([id, userId], name: "economic_activity_id_user_key")
  @@index([userId, deletedAt], name: "economic_activity_user_deleted_idx")
  @@map("economic_activities")
}

/// Cada edición de una actividad crea una revisión inmutable.
model EconomicActivityRevision {
  id String @id @default(uuid())
  activityId String
  userId String
  activity EconomicActivity @relation(fields: [activityId, userId], references: [id, userId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  revision Int
  displayName String @db.VarChar(120)
  registeredActivityCode String? @db.VarChar(100)
  registeredActivityName String @db.VarChar(500)
  activityDescription String @db.Text
  necessaryPurchases String? @db.Text
  revenueVatTreatment String @db.VarChar(50)
  revenueVatTreatmentOther String? @db.Text
  mixedUseDescription String? @db.Text
  additionalFacts String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  profileActivityRevisions TaxpayerProfileActivityRevision[]
  collectionContextActivityRevisions CollectionContextActivityRevision[]

  @@unique([activityId, revision], name: "economic_activity_revision_number_key")
  @@unique([id, userId], name: "economic_activity_revision_id_user_key")
  @@index([userId, activityId], name: "economic_activity_revision_user_activity_idx")
  @@map("economic_activity_revisions")
}

/// Perfil aportado por el usuario, independiente de fuentes normativas.
model TaxpayerProfile {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  revisions TaxpayerProfileRevision[]

  @@unique([id, userId], name: "taxpayer_profile_id_user_key")
  @@index([userId, deletedAt], name: "taxpayer_profile_user_deleted_idx")
  @@map("taxpayer_profiles")
}

model TaxpayerProfileRevision {
  id String @id @default(uuid())
  taxpayerProfileId String
  userId String
  taxpayerProfile TaxpayerProfile @relation(fields: [taxpayerProfileId, userId], references: [id, userId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  revision Int
  displayName String @db.VarChar(120)
  personalIdNumber String? @db.VarChar(10)
  professionalIdNumber String? @db.VarChar(13)
  hasEmploymentIncome Boolean @default(false)
  hasRuc Boolean @default(false)
  taxRegime String @default("unknown") @db.VarChar(50)
  vatFilingFrequency String @default("none") @db.VarChar(20)
  additionalFacts String? @db.Text

  createdAt DateTime @default(now()) @db.Timestamptz
  activities TaxpayerProfileActivityRevision[]
  collectionContextRevisions CollectionContextRevision[]

  @@unique([taxpayerProfileId, revision], name: "taxpayer_profile_revision_number_key")
  @@unique([id, userId], name: "taxpayer_profile_revision_id_user_key")
  @@index([userId, taxpayerProfileId], name: "taxpayer_profile_revision_user_profile_idx")
  @@map("taxpayer_profile_revisions")
}

/// Fija las revisiones de actividad usadas por una revisión de perfil y exige
/// que todos los registros pertenezcan al mismo usuario mediante FKs compuestas.
model TaxpayerProfileActivityRevision {
  id String @id @default(uuid())
  userId String
  taxpayerProfileRevisionId String
  economicActivityRevisionId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  taxpayerProfileRevision TaxpayerProfileRevision @relation(fields: [taxpayerProfileRevisionId, userId], references: [id, userId], onDelete: Restrict)
  economicActivityRevision EconomicActivityRevision @relation(fields: [economicActivityRevisionId, userId], references: [id, userId], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz

  @@unique([taxpayerProfileRevisionId, economicActivityRevisionId], name: "taxpayer_profile_activity_revision_unique")
  @@index([userId, taxpayerProfileRevisionId], name: "taxpayer_profile_activity_user_profile_idx")
  @@map("taxpayer_profile_activity_revisions")
}

model CollectionContextRevision {
  id String @id @default(uuid())
  collectionId String
  userId String
  taxpayerProfileRevisionId String
  purpose String @db.VarChar(50)
  periodStartDate DateTime @db.Date
  periodEndDate DateTime @db.Date
  notes String? @db.Text
  revision Int
  createdAt DateTime @default(now()) @db.Timestamptz

  collection Collection @relation(fields: [collectionId, userId], references: [id, userId], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  taxpayerProfileRevision TaxpayerProfileRevision @relation(fields: [taxpayerProfileRevisionId, userId], references: [id, userId], onDelete: Restrict)
  activities CollectionContextActivityRevision[]

  @@unique([collectionId, revision], name: "collection_context_revision_number_key")
  @@unique([id, userId], name: "collection_context_revision_id_user_key")
  @@index([userId, collectionId], name: "collection_context_revision_user_collection_idx")
  @@map("collection_context_revisions")
}

model CollectionContextActivityRevision {
  id String @id @default(uuid())
  userId String
  collectionContextRevisionId String
  economicActivityRevisionId String
  createdAt DateTime @default(now()) @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  collectionContextRevision CollectionContextRevision @relation(fields: [collectionContextRevisionId, userId], references: [id, userId], onDelete: Restrict)
  economicActivityRevision EconomicActivityRevision @relation(fields: [economicActivityRevisionId, userId], references: [id, userId], onDelete: Restrict)

  @@unique([collectionContextRevisionId, economicActivityRevisionId], name: "collection_context_activity_revision_unique")
  @@index([userId, collectionContextRevisionId], name: "collection_context_activity_user_context_idx")
  @@map("collection_context_activity_revisions")
}

enum FiscalReferenceSourceType {
  MARKDOWN
  PDF
}

/// Material fiscal aportado y autoaprobado por el usuario. No representa una
/// fuente normativa oficial ni una validación jurídica.
model FiscalReference {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  name String @db.VarChar(255)
  sourceType FiscalReferenceSourceType
  storagePath String @db.VarChar(500)
  contentHash String @db.VarChar(71)
  normalizedSize Int

  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  @@index([userId, deletedAt], name: "fiscal_reference_user_deleted_idx")
  @@map("fiscal_references")
}

enum ProviderConnectionProvider {
  OPENAI
  CLAUDE
}

model ProviderConnection {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  provider ProviderConnectionProvider
  label String @db.VarChar(100)
  modelId String @db.VarChar(255)
  isActive Boolean @default(true)
  isDefault Boolean @default(false)

  secretCiphertext String @db.Text
  secretIv String @db.VarChar(64)
  secretAuthTag String @db.VarChar(64)
  secretVersion Int @default(1)
  secretLastFour String @db.VarChar(4)

  probedAt DateTime? @db.Timestamptz
  lastProbeError String? @db.VarChar(255)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz

  @@index([userId, isActive], name: "provider_connection_user_active_idx")
  @@index([userId, deletedAt], name: "provider_connection_user_deleted_idx")
  @@map("provider_connections")
}

enum AuthProvider {
  FIREBASE
}

model AuthIdentity {
  id         String       @id @default(uuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  provider   AuthProvider
  subject    String       @db.VarChar(255)
  linkedAt   DateTime     @default(now()) @db.Timestamptz
  verifiedAt DateTime?    @db.Timestamptz
  disabledAt DateTime?    @db.Timestamptz
  createdAt  DateTime     @default(now()) @db.Timestamptz
  updatedAt  DateTime     @updatedAt @db.Timestamptz

  @@unique([provider, subject], name: "auth_identity_provider_subject_key")
  @@index([userId], name: "auth_identity_user_id_idx")
  @@map("auth_identities")
}

model Collection {
  // collection fields
  id          String  @id @default(uuid())
  name        String  @db.VarChar(100)
  description String? @db.VarChar(255)

  year Int

  // auditable fields
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime?

  // Foreign key to User  userId      String
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // One-to-many relationship with Bill
  bills BillHeader[]
  billMemberships CollectionBillMembership[]
  contextRevisions CollectionContextRevision[]

  @@unique([id, userId], name: "collection_id_user_key")
  @@index([year], name: "collection_year_idx")
  @@index([deletedAt], name: "collection_deleted_at_idx")
  @@map("collections")
}

enum BillFileType {
  XML
  PDF
  TEXT
  MARKDOWN
}

enum BillTargetType {
  PERSONAL
  PROFESSIONAL
  OTHER
}

model BillHeader {
  id String @id @default(uuid())

  number String @db.VarChar(255)
  name   String @db.VarChar(255)

  description String? @db.VarChar(255)

  buyerName         String @db.VarChar(255)
  idBuyer           String @db.VarChar(255)
  totalWithoutTaxes Float  @db.DoublePrecision
  taxes             Float  @db.DoublePrecision
  totalAmount       Float  @db.DoublePrecision

  comercialName String @db.VarChar(255)
  socialName    String @db.VarChar(255)
  idSeller      String @db.VarChar(255)
  addressMatriz String @db.VarChar(255)

  fileType    BillFileType   @default(XML)
  billType    BillTargetType @default(PERSONAL)
  storagePath String         @db.VarChar(255)

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime?

  // Foreign key to Collection
  collectionId String
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  // One-to-many relationship with BillDetail
  details      BillDetail[]
  memberships  CollectionBillMembership[]

  @@index([collectionId], name: "bill_collection_id_idx")
  @@index([deletedAt], name: "bill_deleted_at_idx")
  @@map("bills_header")
}

model CollectionBillMembership {
  id String @id @default(uuid())
  collectionId String
  billId String
  createdAt DateTime @default(now()) @db.Timestamptz

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  bill BillHeader @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([collectionId, billId], name: "collection_bill_membership_unique")
  @@index([billId], name: "collection_bill_membership_bill_idx")
  @@map("collection_bill_memberships")
}

model TaxRuleSource {
  id String @id @default(uuid())
  title String @db.VarChar(500)
  issuer String @db.VarChar(255)
  officialUrl String @db.VarChar(1000)
  jurisdiction String @db.VarChar(100)
  originalStoragePath String @db.VarChar(500)
  derivedMarkdownPath String? @db.VarChar(500)
  contentHash String @db.VarChar(71)
  reviewStatus String @default("draft") @db.VarChar(20)
  reviewedBy String? @db.VarChar(255)
  reviewedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  fragments TaxRuleFragment[]
  @@map("tax_rule_sources")
}

model TaxRuleSet {
  id String @id @default(uuid())
  version Int
  purpose String @db.VarChar(50)
  taxRegime String @db.VarChar(50)
  vatFilingFrequency String @db.VarChar(20)
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  contentHash String @db.VarChar(71)
  reviewStatus String @default("draft") @db.VarChar(20)
  reviewedBy String? @db.VarChar(255)
  reviewedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  fragments TaxRuleSetFragment[]
  @@unique([purpose, taxRegime, vatFilingFrequency, effectiveFrom, version], name: "tax_ruleset_version_key")
  @@index([purpose, taxRegime, vatFilingFrequency, reviewStatus], name: "tax_ruleset_selector_idx")
  @@map("tax_rule_sets")
}

model TaxRuleFragment {
  id String @id @default(uuid())
  sourceId String
  articleOrSection String @db.VarChar(255)
  contentHash String @db.VarChar(71)
  contentMarkdown String @db.Text
  purposes String[]
  taxRegimes String[]
  effectiveFrom DateTime @db.Date
  effectiveTo DateTime? @db.Date
  source TaxRuleSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  ruleSets TaxRuleSetFragment[]
  @@map("tax_rule_fragments")
}

model TaxRuleSetFragment {
  id String @id @default(uuid())
  ruleSetId String
  fragmentId String
  ruleSet TaxRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  fragment TaxRuleFragment @relation(fields: [fragmentId], references: [id], onDelete: Restrict)
  @@unique([ruleSetId, fragmentId], name: "tax_ruleset_fragment_unique")
  @@map("tax_rule_set_fragments")
}

model AnalysisRun {
  id String @id @default(uuid())
  collectionId String
  userId String
  collectionContextRevisionId String?
  taxpayerProfileRevisionId String?
  ruleSetId String?
  providerConnectionId String?
  provider String? @db.VarChar(50)
  modelId String? @db.VarChar(255)
  promptVersion String @db.VarChar(100)
  inputSnapshot Json
  idempotencyKey String @db.VarChar(255)
  status String @db.VarChar(20)
  blockCode String? @db.VarChar(100)
  blockMessage String? @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz
  startedAt DateTime? @db.Timestamptz
  completedAt DateTime? @db.Timestamptz
  results AnalysisResult[]
  invoices AnalysisRunInvoice[]
  @@unique([userId, idempotencyKey], name: "analysis_run_idempotency_key")
  @@index([collectionId, createdAt], name: "analysis_run_collection_created_idx")
  @@map("analysis_runs")
}

model AnalysisRunInvoice {
  id String @id @default(uuid())
  runId String
  billId String
  contentHash String? @db.VarChar(64)
  snapshot Json
  run AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([runId, billId], name: "analysis_run_invoice_unique")
  @@map("analysis_run_invoices")
}

model AnalysisResult {
  id String @id @default(uuid())
  runId String
  billId String
  purpose String @db.VarChar(50)
  classification String @db.VarChar(30)
  resultSnapshot Json
  createdAt DateTime @default(now()) @db.Timestamptz
  run AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@unique([runId, billId], name: "analysis_result_run_bill_unique")
  @@map("analysis_results")
}

model BillDetail {
  id          String @id @default(uuid())
  description String @db.VarChar(255)
  quantity    Int
  unitPrice   Float  @db.DoublePrecision
  discount    Float  @db.DoublePrecision

  // Foreign key to Bill
  billId String
  bill   BillHeader @relation(fields: [billId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime?

  @@index([billId], name: "bill_detail_bill_id_idx")
  @@index([deletedAt], name: "bill_detail_deleted_at_idx")
  @@map("bills_details")
}
