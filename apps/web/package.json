{
  "name": "@bill-lm/web",
  "private": true,
  "type": "module",
  "exports": {
    "./server": "./server.ts"
  },
  "description": "Cloud web application composition root.",
  "scripts": {
    "dev": "vite dev",
    "start": "bun run server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "cd ../.. && ./node_modules/.bin/dotenv -e .env.health -- vitest run --config apps/web/vite.config.ts",
    "worker:dev": "bun run --watch src/integrations/jobs/analyze-job.ts",
    "worker:start": "bun run src/integrations/jobs/analyze-job.ts",
    "db:gen": "../../node_modules/.bin/dotenv -e ../../.env -- prisma generate --config prisma.config.ts",
    "db:deploy": "../../node_modules/.bin/dotenv -e ../../.env -- prisma migrate deploy --config prisma.config.ts",
    "db:push": "../../node_modules/.bin/dotenv -e ../../.env -- prisma db push --config prisma.config.ts",
    "db:migrate": "../../node_modules/.bin/dotenv -e ../../.env -- prisma migrate dev --config prisma.config.ts",
    "db:studio": "../../node_modules/.bin/dotenv -e ../../.env -- prisma studio --config prisma.config.ts",
    "db:seed": "../../node_modules/.bin/dotenv -e ../../.env -- prisma db seed --config prisma.config.ts",
    "rules:sri:check": "bun run scripts/tax-rules.ts check",
    "rules:sri:fetch": "bun run scripts/tax-rules.ts fetch",
    "rules:sri:extract": "bun run scripts/tax-rules.ts extract",
    "rules:sri:split": "bun run scripts/tax-rules.ts split",
    "rules:sri:diff": "bun run scripts/tax-rules.ts diff",
    "rules:sri:run": "bun run scripts/tax-rules.ts run",
    "rules:sri:review": "bun run scripts/tax-rules.ts review",
    "rules:sri:resolve": "bun run scripts/tax-rules.ts resolve",
    "rules:sri:promote": "bun run scripts/tax-rules.ts promote",
    "rules:sri:validate": "bun run scripts/tax-rules.ts validate",
    "rules:sri:build": "bun run scripts/tax-rules.ts build",
    "rules:sri:sync:db": "bun run scripts/tax-rules.ts sync:db",
    "rules:sri:activate:db": "bun run scripts/tax-rules.ts activate:db"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@bill-lm/application": "workspace:*",
    "@bill-lm/contracts": "workspace:*",
    "@bill-lm/domain": "workspace:*",
    "@bill-lm/ui": "workspace:*",
    "@mantine/core": "^8.3.17",
    "@mantine/dates": "^8.3.17",
    "@mantine/dropzone": "^8.3.17",
    "@mantine/hooks": "^8.3.17",
    "@mantine/modals": "^8.3.17",
    "@mantine/notifications": "^8.3.17",
    "@mantine/nprogress": "^8.3.17",
    "@openai/agents": "0.18.0",
    "@openai/agents-openai": "0.18.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@t3-oss/env-core": "^0.13.10",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/start": "^1.120.20",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "bullmq": "^5.71.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "fast-xml-parser": "^5.5.5",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "lucide-react": "^0.545.0",
    "luxon": "^3.7.2",
    "minio": "^8.0.7",
    "openai": "7.27.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "srvx": "^0.11.13",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.5.0",
    "zod": "4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }
}
