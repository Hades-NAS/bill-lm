{
  "project": {
    "name": "bill-lm",
    "description": "Invocie analyzer for ecuador bills",
    "docsPath": "./docs"
  },
  "provider": "codex-cli",
  "database": {
    "type": "sqlite"
  },
  "storage": {
    "dir": ".harness",
    "tasks": {
      "adapter": "local"
    },
    "sections": {
      "toolsUsed": true,
      "filesModified": true,
      "result": true,
      "blockers": true,
      "nextSteps": false
    },
    "markdownFallback": {
      "enabled": true
    },
    "scope": "global",
    "projectId": "d697f96a-588e-4b84-90b8-71eae133e167"
  },
  "health": {
    "scriptPath": "./health.sh",
    "required": true
  },
  "tools": {
    "mcp": {
      "enabled": true,
      "port": 3742
    },
    "scripts": {
      "enabled": true,
      "outputDir": "./.harness/scripts"
    }
  }
}