{
  "name": "bill-lm",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/web dev -- --port 3000",
    "daemon:local": "bun run --cwd apps/local-daemon start",
    "dev:local": "bun run --cwd apps/local-viewer dev -- --port 4319",
    "start": "bun run --cwd apps/web start",
    "build": "bun run --cwd apps/web build",
    "preview": "bun run --cwd apps/web preview",
    "typecheck": "bun run --cwd apps/web typecheck",
    "boundaries:check": "bun run scripts/check-package-boundaries.ts",
    "test": "bun run --cwd apps/web test",
    "test:boundaries": "bun test ./scripts/__tests__/check-package-boundaries.bun.ts",
    "test:local": "bun run --cwd apps/local-daemon test && bun run --cwd apps/local-viewer test",
    "test:e2e": "if [ \"$SKIP_E2E\" = \"true\" ]; then echo 'Skipping e2e tests (SKIP_E2E=true)'; else bun --no-env-file x playwright test; fi",
    "test:e2e:local": "if [ \"$SKIP_E2E\" = \"true\" ]; then echo 'Skipping e2e tests (SKIP_E2E=true)'; else bun --no-env-file x playwright test --config playwright.local-viewer.config.ts; fi",
    "worker:dev": "bun run --cwd apps/web worker:dev",
    "worker:start": "bun run --cwd apps/web worker:start",
    "rules:sri:check": "bun run --cwd apps/web rules:sri:check",
    "rules:sri:fetch": "bun run --cwd apps/web rules:sri:fetch",
    "rules:sri:extract": "bun run --cwd apps/web rules:sri:extract",
    "rules:sri:split": "bun run --cwd apps/web rules:sri:split",
    "rules:sri:diff": "bun run --cwd apps/web rules:sri:diff",
    "rules:sri:run": "bun run --cwd apps/web rules:sri:run",
    "rules:sri:review": "bun run --cwd apps/web rules:sri:review",
    "rules:sri:resolve": "bun run --cwd apps/web rules:sri:resolve",
    "rules:sri:promote": "bun run --cwd apps/web rules:sri:promote",
    "rules:sri:validate": "bun run --cwd apps/web rules:sri:validate",
    "rules:sri:build": "bun run --cwd apps/web rules:sri:build",
    "rules:sri:sync:db": "bun run --cwd apps/web rules:sri:sync:db",
    "rules:sri:activate:db": "bun run --cwd apps/web rules:sri:activate:db",
    "post-cta-init": "bunx --bun create-db@latest --user-agent tanstack/tsrouter",
    "db:gen": "bun run --cwd apps/web db:gen",
    "db:deploy": "bun run --cwd apps/web db:deploy",
    "db:push": "bun run --cwd apps/web db:push",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "db:studio": "bun run --cwd apps/web db:studio",
    "db:seed": "bun run --cwd apps/web db:seed",
    "lint": "eslint",
    "format": "prettier --check .",
    "check": "prettier --write . && eslint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@bill-lm/application": "workspace:*",
    "@bill-lm/contracts": "workspace:*",
    "@bill-lm/domain": "workspace:*",
    "@bill-lm/ui": "workspace:*",
    "@anthropic-ai/sdk": "^0.80.0",
    "@openai/agents-openai": "^0.7.2",
    "@mantine/core": "^8.3.17",
    "@mantine/dates": "^8.3.17",
    "@mantine/dropzone": "^8.3.17",
    "@mantine/hooks": "^8.3.17",
    "@mantine/modals": "^8.3.17",
    "@mantine/notifications": "^8.3.17",
    "@mantine/nprogress": "^8.3.17",
    "@openai/agents": "^0.7.2",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@tanstack/start": "^1.120.20",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "@types/luxon": "^3.7.1",
    "bullmq": "^5.71.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0",
    "fast-xml-parser": "^5.5.5",
    "hono": "4.11.4",
    "install": "^0.13.0",
    "lucide-react": "^0.545.0",
    "luxon": "^3.7.2",
    "minio": "^8.0.7",
    "nitro": "npm:nitro-nightly@latest",
    "openai": "^6.32.0",
    "pdf-parse": "^2.4.5",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.8",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prisma": "^7.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "srvx": "^0.11.13",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "zod": "4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@commitlint/types": "^20.4.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5",
    "zod-prisma-types": "^3.3.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
